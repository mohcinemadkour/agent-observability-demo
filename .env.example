# Copy to .env and adjust. Everything has a safe default; the demo runs fully offline as-is.

# LLM: mock (offline, deterministic) | openai | anthropic
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Background traffic so dashboards are alive when you walk on stage
TRAFFIC=on
TRAFFIC_INTERVAL_S=2

# Host port for Grafana (3000 is often taken by Coolify, dev servers, etc.)
GRAFANA_PORT=3001

# Collector overlay: none | jaeger | vendor   (prefer the make targets)
COLLECTOR_OVERLAY=none

# Only for `make backend-vendor` (preconfigured for Splunk Observability Cloud)
VENDOR_TRACES_URL=
VENDOR_TOKEN=
