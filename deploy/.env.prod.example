# Production settings. On the server:  cp deploy/.env.prod.example .env  and fill in every value.
# Never commit the filled-in .env.

# ---- Domains (create DNS A records pointing to the server's IP first)
DASHBOARD_DOMAIN=dashboard.evaltrust.cloud
DEMO_DOMAIN=demo.evaltrust.cloud
OTLP_DOMAIN=otlp.evaltrust.cloud
ACME_EMAIL=you@example.com

# ---- Grafana admin (you). Use a long random password: openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Control panel login. Generate the hash with:
#   docker run --rm caddy:2.8.4 caddy hash-password --plaintext 'your-password'
# Keep the SINGLE quotes: the hash contains $ signs that must not be expanded.
DEMO_USER=demo
DEMO_PASSWORD_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

# ---- Token a client's agents send as  Authorization: Bearer <token>
# openssl rand -hex 32
OTLP_INGEST_TOKEN=change-me

# ---- Data retention for metrics (days)
RETENTION_DAYS=15

# ---- Agent (same as local)
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TRAFFIC=on
TRAFFIC_INTERVAL_S=4
